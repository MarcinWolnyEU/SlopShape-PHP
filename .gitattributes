# Keep the distributed package to what a consumer actually needs. The
# development tooling is not part of the library, and shipping it would put
# half a megabyte of PHPStan and Pest on everyone's disk.
/.github            export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.php-cs-fixer.cache export-ignore
/.php-cs-fixer.dist.php export-ignore
/.phpunit.cache     export-ignore
/build              export-ignore
/phpstan.neon       export-ignore
/rector.php         export-ignore
/infection.json5    export-ignore
/tools              export-ignore
/phpunit.xml.dist   export-ignore
/composer-require-checker.json export-ignore
/tests              export-ignore
/CONTRIBUTING.md    export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md        export-ignore

# A checksum of a file must not depend on whose machine checked it out, so line
# endings are decided here rather than by each contributor's core.autocrlf.
* text=auto eol=lf

*.png    binary
*.lock   -diff

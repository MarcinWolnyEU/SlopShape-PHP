root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[composer.lock]
insert_final_newline = false
indent_size = 4

[*.txt]
insert_final_newline = false
